<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atv_surface"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/atv_more"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/player"
                style="@style/ControlSheet"
                android:text="@string/play_exo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/decoder"
                style="@style/ControlSheet"
                android:text="@string/decoder_action" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/parse"
                style="@style/ControlSheet"
                android:text="@string/parse"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/reset"
                style="@style/ControlSheet"
                android:text="@string/play_reset" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/replay"
                style="@style/ControlSheet"
                android:text="@string/play_replay" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/repeat"
                style="@style/ControlSheet"
                android:text="@string/play_repeat" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scale"
                style="@style/ControlSheet"
                android:text="@string/play_scale" />

            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/text"
                style="@style/ControlSheet"
                android:tag="3"
                android:text="@string/play_track_text" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/audio"
                style="@style/ControlSheet"
                android:tag="1"
                android:text="@string/play_track_audio" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/video"
                style="@style/ControlSheet"
                android:tag="2"
                android:text="@string/play_track_video" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/danmaku"
                style="@style/ControlSheet"
                android:text="@string/danmaku"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/edition"
                style="@style/ControlSheet"
                android:text="@string/play_edition"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/chapter"
                style="@style/ControlSheet"
                android:text="@string/play_chapter"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/disc_menu"
                style="@style/ControlSheet"
                android:text="@string/play_disc_menu"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/opening"
                style="@style/ControlSheet"
                android:text="@string/play_op" />

            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/ending"
                style="@style/ControlSheet"
                android:text="@string/play_ed" />

            <com.fongmi.android.tv.ui.custom.PlaybackButtonsView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
