<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atv_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="36dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/emptyConfig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/atv_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/atv_shelf_padding_start"
        android:paddingEnd="48dp"
        android:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/atv_empty_vod"
            android:textColor="@color/atv_text_secondary"
            android:textSize="18sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/addVod"
            style="@style/Atv.Primary"
            android:nextFocusUp="@id/navHome"
            android:text="@string/atv_add_vod" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.fongmi.android.tv.ui.custom.AtvSidebar
        android:id="@+id/sidebar"
        android:layout_width="@dimen/atv_sidebar_width"
        android:layout_height="match_parent"
        android:background="@drawable/atv_sidebar_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="28dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="28dp"
        android:elevation="10dp"
        android:focusable="false"
        android:textColor="@color/atv_text_secondary"
        android:textSize="16sp"
        tools:text="09:20" />

</FrameLayout>
