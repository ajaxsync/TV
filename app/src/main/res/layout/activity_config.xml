<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atv_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="48dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/white"
        android:textSize="28sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/dialog_config_hint"
        android:textColor="@color/atv_text_secondary"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/text"
        android:background="@drawable/atv_input_bg"
        android:padding="16dp"
        android:textColorHint="@color/atv_text_secondary"
        android:textCursorDrawable="@drawable/shape_cursor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dialog_config_url"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:nextFocusDown="@id/positive"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/positive"
        style="@style/Atv.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:nextFocusUp="@id/text"
        android:nextFocusDown="@id/choose"
        android:text="@string/atv_load" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/choose"
            style="@style/Atv.Nav"
            android:layout_width="0dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:nextFocusUp="@id/positive"
            android:text="@string/setting_choose" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/phone"
            style="@style/Atv.Nav"
            android:layout_width="0dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:nextFocusUp="@id/positive"
            android:text="@string/phone_input" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/history"
            style="@style/Atv.Nav"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:nextFocusUp="@id/positive"
            android:text="@string/atv_config_history" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
